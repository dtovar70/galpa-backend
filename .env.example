# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://manada:manada@localhost:5432/manada_russo?schema=public

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Admin session: closes after SESSION_IDLE_MINUTES without activity, once the
# "extend session?" prompt (SESSION_PROMPT_SECONDS countdown) runs out.
# The cookie/token lifetime is derived from both (idle + prompt + a small margin).
SESSION_IDLE_MINUTES=30
SESSION_PROMPT_SECONDS=30

# Seed admin (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@manadarusso.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Administrador

# Cloudinary (leave empty to store images on local disk under ./uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
